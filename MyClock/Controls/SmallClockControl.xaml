<UserControl x:Class="MyClock.Controls.SmallClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClock.Controls" 
             xmlns:viewmodels="clr-namespace:MyClock.Controls.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SmallClockDisplayViewModel}"
             mc:Ignorable="d" 
             Margin="5"
             Visibility="{Binding Visible, Mode=OneWay}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"
            Background="#3f3f3f"
            BorderBrush="#3f3f3f">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CityDisplay, Mode=OneWay}"
                       Foreground="#e6e6e6"
                       FontFamily="Calibri"
                       FontSize="20"/>
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                    Grid.Column="2"
                    FontSize="15"
                           FontWeight="DemiBold"
                    FontFamily="Calibri"
                    Foreground="#e6e6e6"
                    HorizontalAlignment="Right"
                    Text="{Binding DayDiff, Mode=OneWay}"
                    Visibility="{Binding PlusOneVisible, Mode=OneWay}"/>
                <TextBlock Grid.Row="1"
                    Grid.Column="1"
                    FontSize="20"
                           FontFamily="Calibri"
                    Foreground="#e6e6e6"
                    HorizontalAlignment="Right"
                    Text="{Binding TimeDisplay, Mode=OneWay}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
