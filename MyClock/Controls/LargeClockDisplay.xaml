<UserControl x:Class="MyClock.Controls.LargeClockDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MyClock.Controls" 
             xmlns:viewmodels="clr-namespace:MyClock.Controls.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ClockDisplayViewModel}"
             mc:Ignorable="d" 
             x:Name="root"
             MouseDoubleClick="LargeClockDisplay_MouseDoubleClick"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="2"
                Width="7"
                CornerRadius="5"
                Margin="10 10 5 5"
                Background="#B83333"/>
        <TextBlock x:Name="TimeTextBlock"
                   Grid.Column="1"
                   HorizontalAlignment="Left"
                   Text="{Binding TimeDisplay, Mode=OneWay}"
                   FontSize="65"
                   FontWeight="Bold"
                   FontFamily="Calibri"
                   Foreground="#e6e6e6"/>
        <TextBlock x:Name="DateTextBlock"
                   Grid.Column="1"
                   Grid.Row="1"
                   HorizontalAlignment="Left"
                   FontSize="25"
                   FontFamily="Calibri"
                   Foreground="#e6e6e6"
                   FontWeight="Bold"
                   Text="{Binding DateDisplay, Mode=OneWay}"
                   IsHitTestVisible="False"/>
    </Grid>
</UserControl>
